POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=manifest_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/manifest_db
PORT=3000
HOST=0.0.0.0

# The selected provider is used for new incident analyses. Groq is the default.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: set LLM_PROVIDER=gemini to use the previous provider instead.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=manifest-incident-operations
