POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=manifest_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@localhost:5432/manifest_db
PORT=3000
HOST=0.0.0.0

# Container API host port (the application listens on 3000 inside Docker).
API_PORT=3000
WORKER_HEALTH_PORT=3001
# Optional managed/internal database URL. Blank derives postgres:5432 from fields above.
CONTAINER_DATABASE_URL=

# The selected provider is used for new incident analyses. Groq is the default.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Leave blank for Groq's normal endpoint; local tests may point to an HTTP simulation.
GROQ_BASE_URL=

# Optional: set LLM_PROVIDER=gemini to use the previous provider instead.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash


TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=manifest-incident-operations

# Remote Temporal endpoint: TLS with a publicly trusted certificate.
# Keep false for the existing local Docker server. API keys require TLS.
TEMPORAL_TLS=false
TEMPORAL_API_KEY=

# Required on Vercel; optional locally. Use a password of at least 20 characters.
# Share privately with the evaluator. Do not put credentials in browser code.
DEMO_USERNAME=
DEMO_PASSWORD=
